# Assurly backend environment configuration template.
# Copy to .env and fill in. Do NOT commit .env.
# Every var below is read by the backend; vars not listed are not used.

# ============================================================
# Database (Cloud SQL via Unix socket in prod; host:port locally)
# ============================================================
# In prod set DB_HOST to the Unix socket path, e.g.
#   /cloudsql/<project>:<region>:<instance>
# Locally DB_HOST can be 'localhost' or '127.0.0.1' if PyMySQL is
# pointed at a TCP listener (the backend currently uses unix_socket=
# in main.py; for TCP local dev you'll need to switch that wiring).
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=

# ============================================================
# JWT
# ============================================================
# Required. Long random string. Generate with assurly-backend/jwt_keygenerator.py.
JWT_SECRET_KEY=
# Optional. Defaults: HS256 / 60 minutes.
JWT_ALGORITHM=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=

# ============================================================
# Magic link auth
# ============================================================
# Required. Frontend base URL — magic links redirect here.
FRONTEND_URL=
# Optional. Default 15 minutes.
MAGIC_LINK_EXPIRE_MINUTES=
# Optional. Defaults: 3 requests per email per 1 hour window.
MAGIC_LINK_RATE_LIMIT_PER_EMAIL=
MAGIC_LINK_RATE_LIMIT_WINDOW_HOURS=

# ============================================================
# Email (Gmail SMTP)
# ============================================================
# Required. Use a Gmail app password, not the account password.
GMAIL_SMTP_EMAIL=
GMAIL_SMTP_PASSWORD=
# Optional. Defaults: smtp.gmail.com / 587.
GMAIL_SMTP_HOST=
GMAIL_SMTP_PORT=
# Optional display fields. Defaults: 'Assurly Platform' / GMAIL_SMTP_EMAIL.
EMAIL_FROM_NAME=
EMAIL_REPLY_TO=

# ============================================================
# Security
# ============================================================
# Optional. bcrypt work factor for password hashing. Default 12.
BCRYPT_ROUNDS=

# ============================================================
# Super-admin allow-list
# ============================================================
# Comma-separated emails granted access to /api/admin/* tooling
# (mock-data generate/wipe). Case-insensitive; whitespace trimmed.
# Leave unset to deny everyone — no DB-level super-admin role exists.
SUPER_ADMIN_EMAILS=

# ============================================================
# Evidence storage (GCS)
# ============================================================
# Bucket name for evidence file uploads. The bucket lives in
# europe-west2; keys are stored under {mat_id}/{mat_standard_id}/.
# NOTE 2026-06-04: this var is referenced in deployment infra but
# the backend Python code does not currently read it directly —
# evidence file_path metadata is persisted in the standard_evidence
# table, while upload + signed-URL handling is external. Listed
# here for completeness and future integration.
GCS_EVIDENCE_BUCKET=
